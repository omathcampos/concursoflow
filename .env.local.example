# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# local | supabase (default: supabase, cai para local se as credenciais acima faltarem)
NEXT_PUBLIC_DATA_SOURCE=supabase

# Usuário técnico fixo usado até a fase 8 (login programático no boot do app para as policies de RLS passarem).
NEXT_PUBLIC_DEV_USER_ID=
NEXT_PUBLIC_DEV_USER_EMAIL=
NEXT_PUBLIC_DEV_USER_PASSWORD=
